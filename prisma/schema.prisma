generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model Agendamento {
  id                String @id @default(cuid())
  tipo              TipoProfissional
  nome              String
  especialidades    String[]
  descricao         String?
  corCalendario     String?
  disponibilidades  Disponibilidade[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}


model Disponibilidade {
  id               String @id @default(cuid())
  profissionalId   String
  profissional     Agendamento @relation(fields: [profissionalId], references: [id], onDelete: Cascade)
  data             DateTime
  localId          String
  local            LocalAtendimento @relation(fields: [localId], references: [id])
  horarios         Horario[]
  createdAt        DateTime @default(now())
}

model Horario {
  id String @id @default(cuid())
  disponibilidadeId String
  disponibilidade Disponibilidade @relation(fields: [disponibilidadeId], references: [id], onDelete: Cascade)
  inicio String
  fim String
}


model LocalAtendimento {
  id                 String   @id @default(cuid())
  nome               String
  telefone           String?
  slug               String
  rua                String
  numero             String
  bairro             String

  pontoDeReferencia  String?
  observacao         String?

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  disponibilidades   Disponibilidade[]
}

model Profissional {
  id              String @id @default(cuid())

  nome            String
  tipo            TipoProfissional

  especialidades  EspecialidadeMedica[]
  exames          TipoExame[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

enum TipoProfissional {
  MEDICO
  LABORATORIO
}

enum EspecialidadeMedica {
  ANGIOLOGIA
  CARDIOLOGIA
  DERMATOLOGIA
  ENDOCRINOLOGIA
  FONOAUDIOLOGO
  GINECOLOGIA
  GASTROENTEROLOGIA
  INFECTOLOGISTA
  HEMATOLOGISTA
  MASTOLOGISTA
  NEUROLOGISTA
  NEFROLOGISTA
  PROTESE
  ENDODONTIA
  ODONTOPEDIATRA
  EXODONTIA
  ORTOPEDIA
  OTORRINO
  OFTALMO
  PNEUMOLOGIA
  PSICOLOGA
  UROLOGISTA
  REUMATOLOGIA
  PSIQUIATRIA

}

enum TipoExame {
  MAPA
  HOLTER
  ULTRASSONOGRAFIA_ARTICULACAO
  ULTRASSONOGRAFIA_ABDOMEM
}